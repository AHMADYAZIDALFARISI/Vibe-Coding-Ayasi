diff --git a/src/routes/itemName.js b/src/routes/itemName.js
new file mode 100644
index 0000000..88ae6e8
--- /dev/null
+++ b/src/routes/itemName.js
@@ -0,0 +1,13 @@
+// Both schemas declare name as varchar(255).
+const MAX_NAME_LENGTH = 255;
+
+function parseItemName(value) {
+    if (typeof value !== 'string') return { error: 'Name must be text.' };
+    const name = value.trim();
+    if (!name) return { error: 'Name cannot be empty.' };
+    if (name.length > MAX_NAME_LENGTH)
+        return { error: `Name must be ${MAX_NAME_LENGTH} characters or fewer.` };
+    return { name };
+}
+
+module.exports = { parseItemName, MAX_NAME_LENGTH };
