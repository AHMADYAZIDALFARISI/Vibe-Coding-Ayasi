+function RenameItemForm({ item, onSaved, onCancel }) {
+    const { Form, Button } = ReactBootstrap;
+
+    const [draft, setDraft] = React.useState(item.name);
+    const [saving, setSaving] = React.useState(false);
+    const [error, setError] = React.useState('');
+    const input = React.useRef(null);
+
+    React.useLayoutEffect(() => {
+        input.current.focus();
+        input.current.select();
+    }, []);
+
+    const save = e => {
+        e.preventDefault();
+        if (draft.trim() === item.name) return onCancel();
+
+        setSaving(true);
+        setError('');
+        requestJson(`/items/${item.id}`, {
+            method: 'PUT',
+            body: JSON.stringify({ name: draft, completed: item.completed }),
+            headers: { 'Content-Type': 'application/json' },
+        })
+            .then(onSaved)
+            .catch(err => {
+                setError(err.message);
+                setSaving(false);
+            });
+    };
+
+    const inputId = `rename-${item.id}`;
+    const errorId = `rename-error-${item.id}`;
+
+    return (
+        <Form className="item" onSubmit={save}>
+            <label htmlFor={inputId} className="sr-only">
+                New name for "{item.name}"
+            </label>
+            <div className="d-flex align-items-center rename-row">
+                <Form.Control
+                    id={inputId}
+                    ref={input}
+                    size="sm"
+                    value={draft}
+                    maxLength={MAX_NAME_LENGTH}
+                    onChange={e => setDraft(e.target.value)}
+                    onKeyDown={e => {
+                        if (e.key === 'Escape' && !saving) onCancel();
+                    }}
+                    readOnly={saving}
+                    isInvalid={Boolean(error)}
+                    aria-describedby={error ? errorId : undefined}
+                />
+                <Button type="submit" size="sm" variant="success" disabled={saving || !draft.trim()}>
+                    {saving ? 'Saving...' : 'Save'}
+                </Button>
+                <Button size="sm" variant="link" onClick={onCancel} disabled={saving}>
+                    Cancel
+                </Button>
+            </div>
+            {error && (
+                <div id={errorId} className="invalid-feedback d-block" role="alert">
+                    {error}
+                </div>
